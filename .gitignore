# ═══════════════════════════════════════════════
# MaBoxImmo — Fichiers exclus du versionnement
# ═══════════════════════════════════════════════

# ── Credentials & configuration locale ──
public_html/config/db.php
public_html/config/smtp.php
public_html/config/smtp_local.php
public_html/config/ubiflow_credentials.local.php
public_html/config/registres.php
db_config.php
.env
.env.local
.env.*.local

# ── Logs ──
*.log
logs/

# ── Uploads utilisateur ──
public_html/uploads/
public_html/api/flux/export/

# ── Temporaires ──
*.tmp
public_html/uploads/_tmp/

# ── Backups & archives ──
backups/
_archive/
_work/
_tmp_*
sauvegarde*/
*backup*
*.backup_*
public_html__backup*/

# ── SQL dumps & gros fichiers ──
*.sql
!sql/migration_*.sql
*.zip
*.tar.gz
*.rar

# ── Config avec credentials dans sous-dossiers ──
**/config/db.php
**/config/smtp.php
**/config/smtp_local.php
**/config/registres.php

# ── SQL dumps volumineux ──
sql/*.sql
!sql/migration_*.sql

# ── Claude settings ──
.claude/

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
