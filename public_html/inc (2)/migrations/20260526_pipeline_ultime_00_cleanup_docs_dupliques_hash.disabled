<?php
/**
 * Migration : Pipeline Ultime 00 — Cleanup docs dupliqués par hash
 *
 * Sprint Pipeline Auto (2026-05-26).
 * À LANCER EN PREMIER (avant la 01 backfill_tenant_ids).
 *
 * Problème : fluxbox_documents avec UK(tenant_id, hash_sha256). Si un doc
 * orphelin tenant=0 a le même hash qu'un doc déjà chez tenant=1, l'UPDATE
 * tenant=0 → tenant=1 de la migration 01 violerait l'UK.
 *
 * Solution :
 *  - Identifier les docs orphelins ayant un jumeau (même hash) chez tenant=1
 *  - Repointer les cartes liées vers le jumeau (UPDATE fluxbox_cartes.document_id)
 *  - DELETE le doc orphelin (le fichier physique reste pareil, c'est le même hash)
 *
 * Idempotent : si aucun doublon, ne fait rien.
 */

return [
    'id'          => '20260526_pipeline_ultime_00_cleanup_docs_dupliques_hash',
    'title'       => 'Pipeline Ultime — Cleanup fluxbox_documents dupliqués par hash (préalable backfill)',
    'description' => "Identifie les fluxbox_documents orphelins (tenant=0/NULL) ayant un jumeau (même hash_sha256) sous tenant=1. Repointe les fluxbox_cartes liées vers le jumeau, puis DELETE le doc orphelin. À lancer AVANT la migration 01 backfill_tenant_ids.",
    'created_at'  => '2026-05-26',
    'sql'         => <<<'SQL'

-- ─── ÉTAPE 1 : Repointer les fluxbox_cartes liées aux docs orphelins doublons
-- vers le doc jumeau (même hash, tenant=1)
UPDATE `fluxbox_cartes` c
INNER JOIN `fluxbox_documents` orphan ON orphan.id = c.document_id
INNER JOIN `fluxbox_documents` twin
        ON twin.hash_sha256 = orphan.hash_sha256
       AND twin.tenant_id = 1
       AND twin.id != orphan.id
SET c.document_id = twin.id,
    c.tenant_id   = 1
WHERE (orphan.tenant_id = 0 OR orphan.tenant_id IS NULL);

-- ─── ÉTAPE 2 : Repointer les ged_documents.fluxbox_source_id
-- (si déjà lié à un doc orphelin) vers le jumeau
UPDATE `ged_documents` ge
INNER JOIN `fluxbox_documents` orphan ON orphan.id = ge.fluxbox_source_id
INNER JOIN `fluxbox_documents` twin
        ON twin.hash_sha256 = orphan.hash_sha256
       AND twin.tenant_id = 1
       AND twin.id != orphan.id
SET ge.fluxbox_source_id = twin.id,
    ge.updated_at = NOW()
WHERE (orphan.tenant_id = 0 OR orphan.tenant_id IS NULL);

-- ─── ÉTAPE 3 : DELETE les fluxbox_documents orphelins doublons (plus aucune référence)
DELETE orphan FROM `fluxbox_documents` orphan
INNER JOIN `fluxbox_documents` twin
        ON twin.hash_sha256 = orphan.hash_sha256
       AND twin.tenant_id = 1
       AND twin.id != orphan.id
WHERE (orphan.tenant_id = 0 OR orphan.tenant_id IS NULL);

-- ─── Vérification post-migration ──────────────────────────────────────
-- SELECT COUNT(*) FROM fluxbox_documents fd1
--   INNER JOIN fluxbox_documents fd2
--     ON fd1.hash_sha256 = fd2.hash_sha256 AND fd1.id != fd2.id
--   WHERE fd1.tenant_id = 1 AND (fd2.tenant_id = 0 OR fd2.tenant_id IS NULL);
-- → attendu 0 (plus aucun doublon orphelin)

SQL
];
