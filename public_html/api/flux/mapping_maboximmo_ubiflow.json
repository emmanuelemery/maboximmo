    "statut": "OK",
    "remarque": ""
  },
  "charges_locatives": {
    "source_maboximmo": "annonces.charges",
    "type_source": "decimal(10,2)",
    "transformation": "ubi_num()",
    "statut": "OK",
    "remarque": ""
  },
  "honoraires_location": {
    "source_maboximmo": "annonces.honoraires",
    "type_source": "decimal(10,2)",
    "transformation": "ubi_num()",
    "statut": "A_TRANSFORMER",
    "remarque": "Meme colonne source que honoraires_negociation (vente) - a conditionner selon type_transaction"
  },
  "depot_garantie": {
    "source_maboximmo": "annonces.depot_garantie",
    "type_source": "decimal(10,2)",
