{
  "_meta": {
    "project": "Agence Emery / MaBoxImmo 2026",
    "date": "2026-04-11",
    "mapping_file": "public_html/config/ubiflow_mapping.php",
    "exporter_file": "public_html/api/flux/ubiflow.php",
    "validator_file": "public_html/inc/ubiflow_validator.php"
  },

  "reference": {
    "source_maboximmo": "annonces.reference_annonce (fallback annonces.id)",
    "type_source": "varchar",
    "transformation": "trim",
    "statut": "OK",
    "remarque": "Fallback sur id si reference_annonce est NULL"
  },
  "texte": {
    "source_maboximmo": "annonces.description",
    "type_source": "text",
    "transformation": "trim + normalize newlines + STRIP_HTML (manquant)",
    "statut": "A_TRANSFORMER",
    "remarque": "BLOQUANT #1 : ubi_str() ne strippe pas les balises HTML. Ajouter strip_tags()+html_entity_decode() dans config/ubiflow_mapping.php:117"
  },
  "titre": {
    "source_maboximmo": "annonces.titre",
    "type_source": "varchar(255)",
    "transformation": "trim",
    "statut": "OK",
    "remarque": ""
  },
  "date_saisie": {
    "source_maboximmo": "annonces.date_creation",
    "type_source": "datetime",
    "transformation": "ubi_date() -> jj/mm/aaaa",
    "statut": "OK",
    "remarque": ""
  },
  "photos": {
    "source_maboximmo": "biens_photos.url_photo via JOIN annonces_photos",
    "type_source": "varchar url",
    "transformation": "JOIN annonces_photos.id_biens_photo = biens_photos.id WHERE id_annonce = ? ORDER BY annonces_photos.ordre ASC",
    "statut": "OK",
    "remarque": "Modele V2 (migration 2026-04-20) : annonces_photos = liaison N:N vers biens_photos. Validator et exporter lisent desormais la meme source."
  },

  "code_type": {
    "source_maboximmo": "types_bien.code",
    "type_source": "varchar (enum applicatif)",
    "transformation": "UBIFLOW_CODE_TYPE[code] -> 1100/1200/1300/1500/2100-2400/3100-3200",
    "statut": "A_TRANSFORMER",
    "remarque": "BLOQUANT #2 : fallback 0 si type inconnu -> ignore par Ubiflow. Exclure la ligne et logguer au lieu de renvoyer 0"
  },
  "libelle_type": {
    "source_maboximmo": "types_bien.libelle",
    "type_source": "varchar",
    "transformation": "trim",
    "statut": "OK",
    "remarque": ""
  },
  "code_postal": {
    "source_maboximmo": "biens.code_postal",
    "type_source": "varchar(10)",
    "transformation": "trim",
    "statut": "OK",
    "remarque": ""
  },
  "ville": {
    "source_maboximmo": "biens.ville",
    "type_source": "varchar(120)",
    "transformation": "trim",
    "statut": "OK",
    "remarque": ""
  },
  "pays": {
    "source_maboximmo": "(hardcode)",
    "type_source": "const",
    "transformation": "force a 'FRA'",
    "statut": "OK",
    "remarque": "Devrait lire biens.pays avec fallback FRA"
  },
  "surface": {
    "source_maboximmo": "biens.surface_habitable (fallback biens.surface_totale)",
    "type_source": "decimal(8,2)",
    "transformation": "ubi_num() - entier si pas de decimale, sinon 2 decimales",
    "statut": "OK",
    "remarque": ""
  },
  "nb_pieces_logement": {
    "source_maboximmo": "biens.nb_pieces",
    "type_source": "tinyint",
    "transformation": "ubi_num()",
    "statut": "OK",
    "remarque": "Validator impose present seulement pour appartement/maison"
  },

  "type": {
    "source_maboximmo": "annonces.type_transaction",
    "type_source": "varchar (enum applicatif)",
    "transformation": "UBIFLOW_PRESTATION_TYPE[code] -> V/L/S/F/B/W/G",
    "statut": "OK",
    "remarque": "Defaut V si transaction inconnue - envisager exception plutot"
  },
  "prix": {
    "source_maboximmo": "annonces.prix",
    "type_source": "decimal(12,2)",
    "transformation": "ubi_num() - 0 ignore",
    "statut": "OK",
    "remarque": ""
  },
  "loyer_mensuel": {
    "source_maboximmo": "annonces.loyer",
    "type_source": "decimal(12,2)",
    "transformation": "ubi_num()",
    "statut": "OK",
    "remarque": ""
  },
  "prix_hors_honoraires": {
