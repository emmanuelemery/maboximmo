    "approche3": {
      "name": "Ciblage Spécifique",
      "description": "Viser une démographie précise (Étudiant/Investisseur/Famille)",
      "html_file": "approche3-ciblage.html",
      "css_file": "styles.css",
      "icon": "🎯",
      "use_cases": [
        "Studio étudiant près des facs",
        "Petit investissement avec bon rendement",
        "Maison pour jeune famille"
      ],
      "available_targets": [
        {
          "id": "etudiant",
          "label": "Étudiant",
          "icon": "🎓",
          "color": "#5dbea3",
          "focus": ["Proximité école/université", "Loyer budget", "Meublé", "Transport facile"],
          "message": "CET APPARTEMENT EST FAIT POUR TOI !"
        },
        {
          "id": "investisseur",
          "label": "Investisseur",
          "icon": "📈",
          "color": "#c67c4e",
          "focus": ["Rendement", "Sécurité", "Zone forte demande", "Marge attractive"],
          "message": "BON RENDEMENT ASSURÉ !"
        },
        {
          "id": "famille",
          "label": "Famille",
          "icon": "👨‍👩‍👧‍👦",
          "color": "#d4a574",
          "focus": ["Espace", "Enfants", "Écoles proximité", "Calme"],
          "message": "LE FOYER DE VOS RÊVES !"
        }
      ],
      "best_for_properties": {
        "etudiant": {
          "property_types": ["Studio", "T2"],
          "features": ["Proximité université", "Loyer budget"],
          "location_keywords": ["faculté", "université", "école"]
        },
        "investisseur": {
          "property_types": ["T2", "T3", "Petite maison"],
          "features": ["Rendement", "Locataires stables"],
          "price_range": "150000-400000"
        },
        "famille": {
          "property_types": ["T3", "T4", "Maison"],
          "features": ["Espace", "Chambres multiples", "Jardin"],
          "location_keywords": ["école", "parc", "calme"]
        }
      },
      "variables_required": [
        "logo_svg",
        "target",
        "icon",
        "header_title",
        "header_subtitle",
        "image_url",
        "price",
        "features"
      ],
      "css_classes": {
        "main": "approach-target",
        "target_classes": ["target-etudiant", "target-investisseur", "target-famille"],
        "formats": ["format-a3", "format-a4", "format-instagram-square", "format-instagram-story", "format-facebook"]
      }
    },

    "approche4": {
      "name": "Multi-Photos Premium",
      "description": "Galerie riche - haut de gamme ou portefeuille",
      "html_file": "approche4-multi-photos.html",
      "css_file": "styles.css",
      "icon": "🖼️🖼️🖼️",
      "use_cases": [
        "Haut de gamme avec plusieurs photos",
        "Vitrines de propriétés exceptionnelles",
        "Portfolios d'immeubles",
        "Bien avec plusieurs angles à montrer"
      ],
      "best_for_properties": {
        "property_types": ["Maison prestige", "Immeuble", "Appartement haut de gamme"],
        "features": ["Galerie riche", "Multiples pièces", "Extérieurs", "Finitions"],
        "price_range": "500000+"
      },
      "variables_required": [
        "logo_svg",
        "title",
        "subtitle",
        "main_image",
        "gallery_images",
        "price",
        "features"
      ],
      "image_recommendations": {
        "main_image": "1:1 ou paysage (séjour, vue générale)",
        "gallery_images": "Minimum 3 (chambre, cuisine, extérieur), idéalement 4",
        "total_images": 5
      },
      "css_classes": {
        "main": "approach-multi",
        "formats": ["format-a3", "format-a4", "format-instagram-square", "format-instagram-story", "format-facebook"]
      }
    }
  },

  "formats": {
    "a3": {
      "name": "A3 Horizontal",
      "dimensions": "1122×1587px",
