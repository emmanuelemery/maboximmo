      "dpi": 150,
      "usage": "Affichage vitrine agence",
      "print": true,
      "digital": true,
      "css_class": "format-a3"
    },
    "a4": {
      "name": "A4 Vertical",
      "dimensions": "794×1123px",
      "aspect_ratio": "210:297mm",
      "dpi": 150,
      "usage": "Papier, PDF email, flyers",
      "print": true,
      "digital": true,
      "css_class": "format-a4"
    },
    "instagram_square": {
      "name": "Instagram Carré",
      "dimensions": "1080×1080px",
      "aspect_ratio": "1:1",
      "dpi": null,
      "usage": "Grille Instagram, Pinterest",
      "print": false,
      "digital": true,
      "platforms": ["instagram", "pinterest", "linkedin"],
      "css_class": "format-instagram-square"
    },
    "instagram_story": {
      "name": "Instagram Story",
      "dimensions": "1080×1920px",
      "aspect_ratio": "9:16",
      "dpi": null,
      "usage": "Stories, Reels, contenu vertical",
      "print": false,
      "digital": true,
      "platforms": ["instagram", "tiktok", "snapchat"],
      "css_class": "format-instagram-story"
    },
    "facebook": {
      "name": "Facebook/LinkedIn",
      "dimensions": "1200×628px",
      "aspect_ratio": "1.91:1",
      "dpi": null,
      "usage": "Partage réseaux professionnels",
      "print": false,
      "digital": true,
      "platforms": ["facebook", "linkedin"],
      "css_class": "format-facebook"
    }
  },

  "smart_selection": {
    "rules": [
      {
        "condition": "property.has_exceptional_view OR property.is_very_bright",
        "approach": "approche1",
        "description": "Une photo exceptionnelle vaut 1000 mots"
      },
      {
        "condition": "property.is_luxury OR property.is_new_building",
        "approach": "approche2",
        "description": "Vendre le lifestyle premium"
      },
      {
        "condition": "property.is_student_oriented AND property.price < 600",
        "approach": "approche3",
        "target": "etudiant",
        "description": "Ciblage étudiant pour petit budget"
      },
      {
        "condition": "property.is_investment_focused AND property.has_tenant",
        "approach": "approche3",
        "target": "investisseur",
        "description": "Ciblage investisseur sur rendement"
      },
      {
        "condition": "property.bedrooms >= 3 AND property.has_garden",
        "approach": "approche3",
        "target": "famille",
        "description": "Ciblage famille sur espace"
      },
      {
        "condition": "property.price > 500000 AND property.has_multiple_photos > 5",
        "approach": "approche4",
        "description": "Haut de gamme nécessite galerie riche"
      }
    ]
  },

  "color_scheme": {
    "primary": "#1a3a4a",
    "accent": "#c9a961",
    "accent_light": "#e8d5b7",
    "text": "#333",
    "text_light": "#666",
    "bg": "#f9f9f9",
    "target_etudiant": "#5dbea3",
    "target_investisseur": "#c67c4e",
    "target_famille": "#d4a574"
  },

  "typography": {
    "display": "'Georgia', serif",
    "body": "'Segoe UI', Tahoma, Geneva, sans-serif",
    "sizes": {
      "title": "2.5rem",
      "subtitle": "1.8rem",
      "body": "0.95rem",
      "small": "0.85rem"
    }
  },

  "export_options": {
    "html": {
      "format": "HTML5",
      "encoding": "UTF-8",
      "inline_css": false
    },
    "image": {
      "formats": ["png", "jpg", "webp"],
      "requires_tool": "wkhtmltoimage OR puppeteer OR cloud API",
      "dpi_options": [72, 150, 300]
    }
  }
}
